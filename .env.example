# Copie para .env e preencha a senha. NUNCA envie o .env para o GitHub (RNF05).

# Conexão direta do Supabase. Se der "Network is unreachable" (IPv6), use o Session pooler:
#   DB_HOST=aws-0-REGIAO.pooler.supabase.com
#   DB_USER=postgres.SEU-PROJETO
DB_HOST=db.SEU-PROJETO.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=unifit

JWT_SECRET=
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Benchmark CPU x GPU no dashboard (roda 100 mil inferências): true só para demonstração
BENCHMARK_ATIVO=false

# De quanto em quanto tempo (segundos) o backend renova matrículas e marca mensalidades atrasadas
ROTINAS_INTERVALO_SEG=900

# Limite de logins errados em 15 minutos (por e-mail e por IP)
LOGIN_MAX_POR_EMAIL=5
LOGIN_MAX_POR_IP=20
